# Local API defaults (export before running, or use direnv).
HTTP_ADDR=:8080
DATABASE_URL=postgres://docforge:docforge@localhost:5432/docforge?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://docforge:docforge@localhost:5672/
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=docforge
S3_ACCESS_KEY=docforge
S3_SECRET_KEY=docforge_secret
S3_USE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=100
DEV_AUTH_DISABLED=true
