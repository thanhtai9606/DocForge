# Local API defaults (export before running, or use direnv).
HTTP_ADDR=:8080
DATABASE_URL=postgres://docforge:docforge@localhost:5432/docforge?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://docforge:docforge@localhost:5672/
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=docforge
MINIO_ACCESS_KEY=docforge
MINIO_SECRET_KEY=docforge_secret
MINIO_USE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=100
DEV_AUTH_DISABLED=true
# OCR: auto | stub | tesseract | http
OCR_PROVIDER=auto
# OCR_URL=http://127.0.0.1:8090
OCR_TIMEOUT=120s
OCR_PARALLEL_PAGES=3

# Upload quota (anonymous vs signed-in users)
ANON_UPLOAD_LIMIT=3
AUTH_UPLOAD_LIMIT=10

# Docker build/push (make docker-package / make login / make docker-push-all)
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=becamexidc2020
VERSION=1.0.3
IMAGE_TAG=1.0.3
