{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    }
  }
}
